# Fortivault Docker Compose Environment Configuration
# Copy this to .env and customize values before running docker-compose up

# Instance ID for container naming (allows multiple instances on same host)
INSTANCE_ID=default

# === Backend (Python FastAPI) ===
DATABASE_PATH=/app/data/vault.db
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this-in-production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
HOST=0.0.0.0
PORT=8000

# === Mail System (Mailpit Internal) ===
SMTP_HOST=fv-mail
SMTP_PORT=1025
MAIL_FROM=noreply@fortivault.local
WEBMAIL_URL=http://localhost:8025

# Mail optional: Production SMTP settings (leave empty for Mailpit)
SMTP_SECURE=false
SMTP_AUTH_USER=
SMTP_AUTH_PASS=

# === NestJS API ===
NESTJS_API_PORT=3001
NESTJS_JWT_SECRET=your-jwt-secret-key-change-in-production
NESTJS_DATABASE_URL=postgresql://user:password@postgres:5432/fortivault

# === Frontend (SvelteKit) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=production

# === Mailpit Configuration ===
MP_MAX_MESSAGES=500
MP_RETENTION_HOURS=720

# === Redis (if using BullMQ) ===
REDIS_URL=redis://redis:6379

# === Database (if using PostgreSQL) ===
DB_HOST=postgres
DB_PORT=5432
DB_USER=fortivault
DB_PASSWORD=change-me-in-production
DB_NAME=fortivault

# === SSL/TLS (for production) ===
# Set to true if using real SSL certificates
USE_SSL=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
